# Скопируйте в .env.deploy и заполните (файл .env.deploy в git не попадает).
# Панель hoster.kz (Plesk): Сайты и домены → caspiancoast.kz → «Учетные записи FTP».
FTP_HOST=185.98.5.153
# Отдельная FTP-учётка для деплоя с домашней папкой /httpdocs
FTP_USER=
FTP_PASS=
# Папка сайта относительно домашней папки FTP-учётки:
#   учётка с домашней папкой /httpdocs → "."
#   системный пользователь (домашняя папка "/") → "httpdocs"
REMOTE_DIR=.
SITE_URL=https://caspiancoast.kz
# Если с шифрованием не подключается — поменяйте на no
FTP_SSL_FORCE=yes
