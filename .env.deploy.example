# Скопируйте в .env.deploy и заполните (файл .env.deploy в git не попадает).
# Доступы FTP — в панели hoster.kz: «FTP-аккаунты» (или в письме при подключении хостинга).
FTP_HOST=ftp.caspiancoast.kz
FTP_USER=
FTP_PASS=
# Папка сайта на сервере
REMOTE_DIR=public_html
SITE_URL=https://caspiancoast.kz
# Если FTP без шифрования не пускает/с шифрованием не подключается — поменяйте на no
FTP_SSL_FORCE=yes
